<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- LeakCanary asks for this to save its files in Downloads. Without it the files stay in the
         folder of the app, which is enough. The app asks for no write access to shared files. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:node="remove" />
</manifest>
