<!--
  Many radio stations stream over plain http and have no https address, so plain http is allowed.
  Android can allow it only for the whole app or for hosts that are known in advance, and a station
  can be on any host. The rule that keeps the rest on https is in the code: everything that is not a
  stream must use an https address.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
