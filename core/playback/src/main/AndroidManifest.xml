<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Radio streams. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      The session callback reads the signing certificate of the two apps that may browse: Android Auto and
      the Google app. Android hides other apps from this one unless they are named here, and a hidden app
      would be refused.
    -->
    <queries>
        <package android:name="com.google.android.projection.gearhead" />
        <package android:name="com.google.android.googlequicksearchbox" />
    </queries>

    <application android:networkSecurityConfig="@xml/network_security_config">
        <!-- Tells Android Auto that this app is a media app, so it shows in the car. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!--
          Exported so the system, Bluetooth and the car can reach the session. No permission can guard it,
          because those callers hold none of ours. The session callback checks every caller instead.
        -->
        <service
            android:name=".service.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!--
          Serves cover pictures to the car, which can load a picture only from an address of the app. It is
          exported because the car is another app, and no permission can guard it, as the car holds none of
          ours. The provider checks the caller itself, serves two kinds of path and refuses everything else.
        -->
        <provider
            android:name=".artwork.ArtworkProvider"
            android:authorities="${applicationId}.artwork"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />

        <!--
          Starts the playback service when a headset or a car sends "play" while the app is not running.
          The service then plays what was saved last.
        -->
        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
