<!-- Android lint checks that RULES.md relies on are errors, so they fail the build. -->
<lint>
    <!-- U6: user facing text is a string resource -->
    <issue id="HardcodedText" severity="error" />
    <!-- U10: accessibility -->
    <issue id="ContentDescription" severity="error" />
    <!-- S2: nothing is exported unless it must be -->
    <issue id="ExportedService" severity="error" />
    <issue id="ExportedReceiver" severity="error" />
    <issue id="ExportedContentProvider" severity="error" />
    <!-- S3: immutable PendingIntent, no implicit intent for internal work -->
    <issue id="UnspecifiedImmutableFlag" severity="error" />
    <issue id="UnsafeImplicitIntentLaunch" severity="error" />
    <!-- S5: no all files access -->
    <issue id="ScopedStorage" severity="error" />
</lint>
